# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. Server only. Used solely by app/api/account/delete.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, Phase 2. Powers Scripture reference suggestions on the
# interpretation screen only. If left unset, that feature quietly does
# nothing rather than breaking the page. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Comma separated list of email addresses allowed to reach /admin, where
# Vault content and Circles are managed without touching SQL directly.
ADMIN_EMAILS=you@example.com,someone-else@example.com

# Optional. Powers "search by meaning" on the dreams list. Anthropic does
# not currently offer a public embeddings endpoint, so this uses OpenAI's
# text-embedding-3-small instead, a separate key from ANTHROPIC_API_KEY.
# Get one at platform.openai.com. Without it, meaning based search falls
# back to exact word search automatically.
OPENAI_API_KEY=your-openai-api-key
