# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. Server only. Used by app/api/account/delete, admin
# actions under lib/actions/admin-*.ts and lib/actions/circle-moderation.ts,
# and the public testimony share page at app/t/[token] (scoped there to
# testimonies with is_private = false only).
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, Phase 2. Powers Scripture reference suggestions on the
# interpretation screen only. If left unset, that feature quietly does
# nothing rather than breaking the page. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Comma separated list of email addresses allowed to reach /admin, where
# Vault content and Circles are managed without touching SQL directly.
ADMIN_EMAILS=you@example.com,someone-else@example.com

# Optional. Powers "search by meaning" on the dreams list, and the voice
# capture fallback (app/api/dreams/transcribe) for browsers without
# SpeechRecognition support (Firefox, and some Safari versions). Anthropic
# does not currently offer public embeddings or transcription endpoints, so
# this uses OpenAI's text-embedding-3-small and whisper-1 instead, a
# separate key from ANTHROPIC_API_KEY. Get one at platform.openai.com.
# Without it, meaning based search falls back to exact word search, and the
# voice fallback is simply not offered — the live-caption path still works
# wherever the browser supports it.
OPENAI_API_KEY=your-openai-api-key
